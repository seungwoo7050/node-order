generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
  demo_admin
}

model User {
  id            String      @id
  name          String
  role          Role        @default(user)
  passwordHash  String?     @map("password_hash")
  githubId      String?     @unique @map("github_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  expiresAt     DateTime?   @map("expires_at")
  isGuest       Boolean     @default(false) @map("is_guest")
  phone         String?
  recipientName String?     @map("recipient_name")
  recipientPhone String?    @map("recipient_phone")
  postalCode    String?     @map("postal_code")
  address1      String?
  address2      String?
  deliveryMemo  String?     @map("delivery_memo")
  orders        Order[]
  refreshTokens RefreshToken[]
  accessTokens  AccessToken[]

  @@index([expiresAt])
  @@map("users")
}

model Order {
  id                Int         @id @default(autoincrement())
  userId            String      @map("user_id")
  user              User        @relation(fields: [userId], references: [id])
  totalAmount       Int         @map("total_amount")
  paid              Boolean
  createdAt         DateTime    @default(now()) @map("created_at")
  stripeSessionId   String?     @unique @map("stripe_session_id")
  canceledAt        DateTime?   @map("canceled_at")
  // 0032: 주문 상태(src/fulfillment/order-state.ts의 전이 표). paid·canceled_at은 expand 동안 앱이 같이 맞춘다
  status            OrderStatus @default(pending_payment)
  statusChangedAt   DateTime    @default(now()) @map("status_changed_at")
  deliveredAt       DateTime?   @map("delivered_at")
  shippingFee       Int         @default(0) @map("shipping_fee") // total_amount에 포함된다
  // 배송지 사본(옛 주문은 비어 있다). 연락처·주소는 로그에 마스킹해서만 남긴다(src/fulfillment/mask.ts)
  recipientName     String?     @map("recipient_name")
  recipientPhone    String?     @map("recipient_phone")
  postalCode        String?     @map("postal_code")
  address1          String?
  address2          String?
  deliveryMemo      String?     @map("delivery_memo")
  // 0033: 결제할 때 손님이 동의한 개인정보처리방침 버전과 시각(옛 주문은 비어 있다)
  privacyConsentVersion Int?      @map("privacy_consent_version")
  privacyConsentedAt    DateTime? @map("privacy_consented_at")
  // 0037: 비회원 주문 여부 및 비회원 조회용 비밀번호 해시, 주문 당시 반품 왕복 배송비 스냅샷
  isGuest           Boolean     @default(false) @map("is_guest")
  guestPasswordHash String?     @map("guest_password_hash")
  returnShippingFee Int         @default(6000) @map("return_shipping_fee")
  items             OrderItem[]
  payment           Payment?
  history           OrderStatusHistory[]
  shipments         Shipment[]
  returns           Return[]

  @@index([createdAt, id])
  @@index([userId, createdAt, id])
  @@index([status, createdAt, id])
  @@index([status, statusChangedAt])
  @@index([isGuest, createdAt(sort: Desc), id(sort: Desc)], map: "orders_is_guest_created_at_id_idx")
  @@map("orders")
}

enum OrderStatus {
  pending_payment
  paid
  preparing
  shipped
  delivered
  confirmed
  canceled
}

enum ActorType {
  customer
  admin
  system
}

enum ReturnKind {
  refund
  exchange
}

enum ReturnStatus {
  requested
  approved
  rejected
  completed
}

enum ReturnReason {
  change_of_mind // 단순변심: 왕복 배송비를 환불액에서 뺀다
  defective
  wrong_item
}

// 상태 이력(0032). 전이 하나에 한 행. RLS 정책은 마이그레이션 SQL에만 있다
model OrderStatusHistory {
  id         Int         @id @default(autoincrement())
  orderId    Int         @map("order_id")
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus @map("from_status")
  toStatus   OrderStatus @map("to_status")
  actorType  ActorType   @map("actor_type")
  actorId    String?     @map("actor_id")
  reason     String?
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([orderId, id])
  @@map("order_status_history")
}

// 송장(0032). 주문의 첫 발송은 returnId가 없고(주문당 하나, 부분 unique 인덱스는 SQL에만), 교환품 발송은 반품 요청에 붙는다
model Shipment {
  id             Int      @id @default(autoincrement())
  orderId        Int      @map("order_id")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnId       Int?     @unique @map("return_id")
  return         Return?  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  carrier        String
  trackingNumber String   @map("tracking_number")
  shippedAt      DateTime @default(now()) @map("shipped_at")

  @@index([orderId])
  @@map("shipments")
}

// 반품·교환 요청(0032). 환불은 refunds의 멱등 키 return-<id>로 이어진다
model Return {
  id           Int          @id @default(autoincrement())
  orderId      Int          @map("order_id")
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind         ReturnKind
  status       ReturnStatus @default(requested)
  reason       ReturnReason
  detail       String?
  refundAmount Int?         @map("refund_amount")
  rejectReason String?      @map("reject_reason")
  requestedAt  DateTime     @default(now()) @map("requested_at")
  decidedAt    DateTime?    @map("decided_at")
  completedAt  DateTime?    @map("completed_at")
  items        ReturnItem[]
  shipment     Shipment?

  @@index([orderId])
  @@index([status])
  @@map("returns")
}

model ReturnItem {
  returnId  Int     @map("return_id")
  return    Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Int     @map("unit_price")

  @@id([returnId, productId])
  @@map("return_items")
}

enum PaymentProvider {
  stripe
  toss
  manual // 관리자·seed가 결제 완료로 만든 주문(PG를 거치지 않았다)
}

enum PaymentStatus {
  ready
  paid
  partial_refunded
  refunded
  canceled
}

enum RefundStatus {
  requested
  succeeded
  failed
}

// 결제(0030). 주문 하나에 하나. 상태 전이는 조건부 update(WHERE status = ...)로 한 번만 일어난다
// amount >= 0 CHECK와 RLS 정책은 마이그레이션 SQL에만 있다
model Payment {
  id                 Int             @id @default(autoincrement())
  orderId            Int             @unique @map("order_id")
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Restrict) // 0031: 주문을 지워도 결제 기록은 남는다
  provider           PaymentProvider
  providerOrderId    String          @map("provider_order_id")
  providerPaymentKey String?         @map("provider_payment_key")
  amount             Int
  status             PaymentStatus   @default(ready)
  approvedAt         DateTime?       @map("approved_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at")
  refunds            Refund[]

  @@unique([provider, providerOrderId])
  @@unique([provider, providerPaymentKey])
  @@map("payments")
}

// 환불(0030). 결제 하나에 여러 번. requested로 먼저 커밋하고 PG를 부른 뒤 succeeded·failed로 바꾼다
model Refund {
  id                Int          @id @default(autoincrement())
  paymentId         Int          @map("payment_id")
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount            Int
  reason            String
  idempotencyKey    String       @unique @map("idempotency_key")
  providerRefundKey String?      @map("provider_refund_key")
  status            RefundStatus @default(requested)
  failureReason     String?      @map("failure_reason")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at")

  @@index([paymentId])
  @@index([status, createdAt])
  @@map("refunds")
}

model StripeEvent {
  id            String      @id
  type          String
  processedAt   DateTime    @default(now()) @map("processed_at")

  @@map("stripe_events")
}

model Product {
  id            Int         @id @default(autoincrement())
  name          String
  price         Int
  stock         Int
  description   String      @default("")
  imageKey      String?     @map("image_key")
  items         OrderItem[]
  returnItems   ReturnItem[]
  categoryId    Int?        @map("category_id")
  category      Category?   @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("products")
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String
  parentId Int?       @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model OrderItem {
  orderId       Int       @map("order_id")
  order         Order     @relation(fields: [orderId], references: [id])
  productId     Int       @map("product_id")
  product       Product   @relation(fields: [productId], references: [id])
  quantity      Int
  unitPrice     Int       @map("unit_price")

  @@id([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model IdempotencyKey {
  userId        String      @map("user_id")
  key           String
  requestHash   String      @map("request_hash")
  response      Json?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@id([userId, key])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id            Int         @id @default(autoincrement())
  type          String
  userId        String      @map("user_id") // 알림을 받을 사용자
  payload       Json
  createdAt     DateTime    @default(now()) @map("created_at")
  publishedAt   DateTime?   @map("published_at")

  @@map("outbox_events")
}

// 검색 문서(0028). 쓰기는 src/search/pg-search-engine.ts의 SQL만 한다(tokens는 tsvector)
// 트리거(products·categories → search_dirty)와 pg_trgm 확장은 마이그레이션 SQL에만 있다
// migrate diff는 text_pattern_ops 인덱스를 늘 지웠다 다시 만들자고 한다(같은 정의라 무시한다)
model ProductSearch {
  productId     Int                      @id @map("product_id")
  name          String
  categoryNames String                   @default("") @map("category_names")
  description   String                   @default("")
  tokens        Unsupported("tsvector")
  indexedAt     DateTime                 @default(now()) @map("indexed_at")

  @@index([tokens], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_search_name_trgm_idx")
  @@index([name(ops: raw("text_pattern_ops"))], map: "product_search_name_prefix_idx")
  @@map("product_search")
}

// 색인할 상품(outbox). 상품 id가 기본키라 여러 번 고쳐도 한 행
model SearchDirty {
  productId Int      @id @map("product_id")
  markedAt  DateTime @default(now()) @map("marked_at")
  version   BigInt   @default(autoincrement()) // 기록할 때마다 새 값(0029). 가져간 version 그대로인 행만 지운다
  claimedAt DateTime? @map("claimed_at")

  @@map("search_dirty")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// 상점 설정(0033). 한 행(id = 1, CHECK는 SQL에만). 저장은 version이 같을 때만(낙관적 잠금, If-Match)
// 비밀값(PG 키 등)은 여기 두지 않는다: 환경변수에만 있고 화면은 GET /features로 연결 여부만 본다
model StoreSettings {
  id                    Int      @id @default(1)
  storeName             String   @map("store_name")
  representative        String
  businessNumber        String   @map("business_number") // 숫자 10자리(체크섬 검증은 앱)
  mailOrderNumber       String   @map("mail_order_number") // 통신판매업 신고번호
  address               String
  phone                 String
  email                 String
  privacyOfficer        String   @map("privacy_officer")
  shippingFee           Int      @map("shipping_fee")
  freeShippingThreshold Int      @map("free_shipping_threshold")
  returnShippingFee     Int      @map("return_shipping_fee")
  lowStockThreshold     Int      @map("low_stock_threshold")
  version               Int      @default(1)
  updatedAt             DateTime @default(now()) @map("updated_at")

  @@map("store_settings")
}

enum LegalKind {
  terms
  privacy
  refund
}

// 약관·개인정보처리방침·청약철회 안내(0033). 고치면 새 버전 행이 생기고 지난 버전은 그대로 남는다
model LegalDocument {
  id          Int       @id @default(autoincrement())
  kind        LegalKind
  version     Int
  title       String
  body        String
  effectiveAt DateTime  @map("effective_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([kind, version])
  @@map("legal_documents")
}

enum ReconciliationIssueKind {
  amount_mismatch
  status_mismatch
  missing_in_db
  missing_in_pg
  refund_mismatch
}

// PG 대사 실행(0033). provider 하나에 한 행. 실패해도 남는다(error)
model ReconciliationRun {
  id          Int             @id @default(autoincrement())
  provider    PaymentProvider
  periodStart DateTime        @map("period_start")
  periodEnd   DateTime        @map("period_end")
  startedAt   DateTime        @default(now()) @map("started_at")
  finishedAt  DateTime?       @map("finished_at")
  pgCount     Int             @default(0) @map("pg_count") // PG가 알려 준 결제 수
  dbCount     Int             @default(0) @map("db_count") // 우리 쪽에서 맞춰 본 결제 수
  issueCount  Int             @default(0) @map("issue_count")
  error       String?

  @@index([periodStart, provider])
  @@map("reconciliation_runs")
}

// PG 대사 불일치(0033). (provider, 종류, PG 결제 키)가 자연 키라 다시 돌려도 같은 행을 고친다
model ReconciliationIssue {
  id             Int                     @id @default(autoincrement())
  provider       PaymentProvider
  businessDate   DateTime                @map("business_date") @db.Date // 처음 발견한 대사 기준일(Asia/Seoul)
  kind           ReconciliationIssueKind
  paymentKey     String                  @map("payment_key")
  orderId        Int?                    @map("order_id")
  ourValue       Json?                   @map("our_value")
  pgValue        Json?                   @map("pg_value")
  firstSeenAt    DateTime                @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime                @default(now()) @map("last_seen_at")
  resolvedAt     DateTime?               @map("resolved_at")
  resolutionNote String?                 @map("resolution_note")

  @@unique([provider, kind, paymentKey])
  @@index([resolvedAt])
  @@map("reconciliation_issues")
}

// MCP 개인 접근 토큰(30). 원문은 발급할 때 한 번만 보이고 sha256 해시만 저장한다.
// 범위: read(읽기 도구), write(상태·재고를 바꾸는 도구), pii(손님 연락처·주소 원문). 데모 관리자가 발급하면 read만
model AccessToken {
  id         Int              @id @default(autoincrement())
  userId     String           @map("user_id")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String           @unique @map("token_hash")
  prefix     String // 목록에서 알아보게 원문 앞 몇 글자만
  scopes     String[]
  expiresAt  DateTime         @map("expires_at")
  revokedAt  DateTime?        @map("revoked_at")
  lastUsedAt DateTime?        @map("last_used_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  audits     McpAuditEntry[]

  @@index([userId])
  @@map("access_tokens")
}

// MCP 도구 호출 감사 로그. 호출 한 번에 한 행. 인자는 연락처를 가린 요약만 남긴다
model McpAuditEntry {
  id        Int         @id @default(autoincrement())
  tokenId   Int         @map("token_id")
  token     AccessToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  tool      String
  args      Json
  ok        Boolean
  // 0036: ok | error | rate_limited | pending(쓰기 도구 실행 전에 남긴 행). CHECK는 마이그레이션 SQL에만 있다
  result    String      @default("ok")
  error     String?
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([tokenId, id])
  @@index([createdAt])
  @@map("mcp_audit_log")
}
