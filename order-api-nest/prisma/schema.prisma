generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
  demo_admin
}

model User {
  id            String      @id
  name          String
  role          Role        @default(user)
  passwordHash  String?     @map("password_hash")
  githubId      String?     @unique @map("github_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  expiresAt     DateTime?   @map("expires_at")
  orders        Order[]
  refreshTokens RefreshToken[]

  @@index([expiresAt])
  @@map("users")
}

model Order {
  id                Int         @id @default(autoincrement())
  userId            String      @map("user_id")
  user              User        @relation(fields: [userId], references: [id])
  totalAmount       Int         @map("total_amount")
  paid              Boolean
  createdAt         DateTime    @default(now()) @map("created_at")
  stripeSessionId   String?     @unique @map("stripe_session_id")
  canceledAt        DateTime?   @map("canceled_at")
  items             OrderItem[]

  @@index([createdAt, id])
  @@index([userId, createdAt, id])
  @@map("orders")
}

model StripeEvent {
  id            String      @id
  type          String
  processedAt   DateTime    @default(now()) @map("processed_at")

  @@map("stripe_events")
}

model Product {
  id            Int         @id @default(autoincrement())
  name          String
  price         Int
  stock         Int
  description   String      @default("")
  imageKey      String?     @map("image_key")
  items         OrderItem[]
  categoryId    Int?        @map("category_id")
  category      Category?   @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("products")
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String
  parentId Int?       @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model OrderItem {
  orderId       Int       @map("order_id")
  order         Order     @relation(fields: [orderId], references: [id])
  productId     Int       @map("product_id")
  product       Product   @relation(fields: [productId], references: [id])
  quantity      Int
  unitPrice     Int       @map("unit_price")

  @@id([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model IdempotencyKey {
  userId        String      @map("user_id")
  key           String
  requestHash   String      @map("request_hash")
  response      Json?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@id([userId, key])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id            Int         @id @default(autoincrement())
  type          String
  userId        String      @map("user_id") // 알림을 받을 사용자
  payload       Json
  createdAt     DateTime    @default(now()) @map("created_at")
  publishedAt   DateTime?   @map("published_at")

  @@map("outbox_events")
}

// 검색 문서(0028). 쓰기는 src/search/pg-search-engine.ts의 SQL만 한다(tokens는 tsvector)
// 트리거(products·categories → search_dirty)와 pg_trgm 확장은 마이그레이션 SQL에만 있다
// migrate diff는 text_pattern_ops 인덱스를 늘 지웠다 다시 만들자고 한다(같은 정의라 무시한다)
model ProductSearch {
  productId     Int                      @id @map("product_id")
  name          String
  categoryNames String                   @default("") @map("category_names")
  description   String                   @default("")
  tokens        Unsupported("tsvector")
  indexedAt     DateTime                 @default(now()) @map("indexed_at")

  @@index([tokens], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_search_name_trgm_idx")
  @@index([name(ops: raw("text_pattern_ops"))], map: "product_search_name_prefix_idx")
  @@map("product_search")
}

// 색인할 상품(outbox). 상품 id가 기본키라 여러 번 고쳐도 한 행
model SearchDirty {
  productId Int      @id @map("product_id")
  markedAt  DateTime @default(now()) @map("marked_at")

  @@map("search_dirty")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}