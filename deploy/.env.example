ACTIVE=
BLUE_TAG=
GREEN_TAG=

WEB_HOST=shop.3-24-1-2.sslip.io
API_HOST=api.3-24-1-2.sslip.io

AWS_REGION=ap-northeast-2
S3_BUCKET=

ADMIN_DATABASE_URL=postgresql://order_owner:<소유자 비밀번호>@<RDS 엔드포인트>:5432/order_api?sslmode=verify-full
DATABASE_URL=postgresql://order_app:<앱 비밀번호>@<RDS 엔드포인트>:5432/order_api?sslmode=verify-full

JWT_SECRET=
AUTH_SECRET=
DEMO_PASSWORD=
DEMO_LOGIN=0

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 토스페이먼츠(결제위젯 연동 키: 개발자센터 API 키 메뉴의 "주문서형·결제창형" 키). 둘 다 있어야 켜진다
# 문서용 공개 테스트 키는 공식 문서에서 값을 확인하지 못해 비워 둔다. 운영에는 시뮬레이터를 쓰지 않는다(NODE_ENV=production이면 무시)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

RATE_LIMIT_ALLOW_IPS=

LLM_API_KEY=

# 관측(31). 모두 선택이다. 비어 있으면 오류 추적은 꺼지고, 경보·Watchdog은 null 수신자로 간다(기동은 된다)
# 오류 추적 DSN(Sentry 또는 같은 규약의 GlitchTip). 콘솔을 다른 프로젝트로 나누려면 SENTRY_WEB_DSN
SENTRY_DSN=
SENTRY_WEB_DSN=
# 경보 웹훅(Slack 호환. Discord는 웹훅 주소 끝에 /slack)과 dead man's switch(healthchecks 호환 핑 주소)
ALERT_WEBHOOK_URL=
DEADMAN_URL=
# 알림의 런북 링크 앞부분(비우면 저장소 main 브랜치). 서버에서 monitoring/ 위치(CI가 /opt/node-order/monitoring에 올린다)
RUNBOOK_BASE_URL=
MONITORING_DIR=./monitoring
# 하루 LLM 토큰 상한(경보), 결제 뒤 며칠 넘게 미착수면 처리 지연인지
LLM_DAILY_TOKEN_BUDGET=200000
FULFILLMENT_OVERDUE_DAYS=3
