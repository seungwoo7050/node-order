ACTIVE=
BLUE_TAG=
GREEN_TAG=

WEB_HOST=shop.3-24-1-2.sslip.io
API_HOST=api.3-24-1-2.sslip.io

AWS_REGION=ap-northeast-2
S3_BUCKET=

ADMIN_DATABASE_URL=postgresql://order_owner:<소유자 비밀번호>@<RDS 엔드포인트>:5432/order_api?sslmode=verify-full
DATABASE_URL=postgresql://order_app:<앱 비밀번호>@<RDS 엔드포인트>:5432/order_api?sslmode=verify-full

JWT_SECRET=
AUTH_SECRET=
DEMO_PASSWORD=
DEMO_LOGIN=0

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 결제 연동(0원 운영 가능):
# 1. 토스페이먼츠: https://developers.tosspayments.com 무료 가입 후 [내 개발정보] -> [API 키]의 테스트 키를 넣으면 실제 결제창/위젯이 무료로 동작한다.
#    TOSS_CLIENT_KEY=test_ck_...
#    TOSS_SECRET_KEY=test_sk_...
# 2. Stripe(선택): 비워두면 토스페이먼츠만 결제 수단으로 켜진다.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 토스페이먼츠(결제위젯 연동 키: 개발자센터 API 키 메뉴의 "주문서형·결제창형" 키). 둘 다 있어야 켜진다.
# 무료 개발자 계정의 테스트 키(test_ck_..., test_sk_...)를 넣으면 결제창 테스트가 가능하다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

RATE_LIMIT_ALLOW_IPS=

# LLM 상품 설명 생성(선택/비용 0원): 비워두면 화면에서 AI 버튼이 자동으로 숨겨지며 비용이 들지 않는다.
LLM_API_KEY=

# 관측(31). 모두 선택이다. 비어 있으면 오류 추적은 꺼지고, 경보·Watchdog은 null 수신자로 간다(기동은 된다, 비용 0원 유지)
# 오류 추적 DSN(Sentry 무료 티어 또는 같은 규약의 GlitchTip). 비워두면 비활성화.
SENTRY_DSN=
SENTRY_WEB_DSN=
# 경보 웹훅(Slack 호환, Discord 무료 웹훅은 주소 끝에 /slack)과 dead man's switch(healthchecks.io 무료 핑 주소). 비워두면 null 수신자.
ALERT_WEBHOOK_URL=
DEADMAN_URL=
# 알림의 런북 링크 앞부분(비우면 저장소 main 브랜치). 서버에서 monitoring/ 위치(CI가 /opt/node-order/monitoring에 올린다)
RUNBOOK_BASE_URL=
MONITORING_DIR=./monitoring
# 하루 LLM 토큰 상한(경보), 결제 뒤 며칠 넘게 미착수면 처리 지연인지
LLM_DAILY_TOKEN_BUDGET=200000
FULFILLMENT_OVERDUE_DAYS=3
